{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "ON",
                "SPHINXSYS_SYCL_TARGETS": "nvptx64-nvidia-cuda"
            }
        },
        {
            "name": "ModifedDebug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "ON",
                "SPHINXSYS_SYCL_TARGETS": "nvptx64-nvidia-cuda -arch=sm_61"
            }
        }
        ,        
     
        
        {
            "name": "Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "ON",
                "SPHINXSYS_SYCL_TARGETS": "nvptx64-nvidia-cuda"
            }
        },

        {
            "name": "RelWithDebInfo",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "ON",
                "SPHINXSYS_SYCL_TARGETS": "nvptx64-nvidia-cuda",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -fno-omit-frame-pointer -fno-inline -fsanitize=undefined,float-divide-by-zero,float-cast-overflow -Werror=reorder -w",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -fno-omit-frame-pointer -fno-inline -fsanitize=undefined,float-divide-by-zero,float-cast-overflow -Werror=reorder -w",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
            }
        },        
                
        {
            "name": "UpdatedRelease",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-updated",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "OFF",
                "SPHINXSYS_SYCL_TARGETS": "nvptx64-nvidia-cuda",
                "CMAKE_CXX_FLAGS": "-Werror=reorder"
            }
        },        
        
        {
            "name": "ReleaseForRegression",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "icx",
                "CMAKE_CXX_COMPILER": "icpx",
                "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "SPHINXSYS_USE_SYCL": "ON"
            }
        },
        {
            "name": "release-unix",
            "generator": "Unix Makefiles",
            "description": "Release build with Unix Makefiles generator",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
              "CMAKE_BUILD_TYPE": "Release",
              "CMAKE_C_COMPILER": "gcc",
              "CMAKE_CXX_COMPILER": "g++",
              "CMAKE_TOOLCHAIN_FILE": "${env:HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
              "CMAKE_C_COMPILER_LAUNCHER": "ccache",
              "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
              "CMAKE_CXX_FLAGS": "-Wno-unused-variable -Wno-reorder -Wno-unused-but-set-variable"
            }
        },
        {
            "name": "Release-Debug",
            "generator": "Unix Makefiles",
            "description": "Debug build with Unix Makefiles generator",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "/home/li/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_FLAGS": "-Wno-unused-variable -Wno-reorder -Wno-unused-but-set-variable -g"
            }
        }           
    ]
}
